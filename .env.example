PROJECT_NAME="BankMate AI"
API_V1_PREFIX="/api"

# PostgreSQL Database Connection (e.g. Neon, Supabase, or Local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
SYNC_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Chroma Vector Store
CHROMA_PERSIST_DIR="./chroma_db"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Security & Auth
SECRET_KEY="generate-a-secure-random-key-here"
ADMIN_USERNAME="admin@bankmate.ai"
ADMIN_PASSWORD="BankMateAdmin2026!"

# Optional Groq API Key (from console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
